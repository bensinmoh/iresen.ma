# Template only: configure real values in your hosting provider's secret store.
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_HOST:5432/DATABASE
PAYLOAD_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Set the real HTTPS origin BEFORE building and at runtime.
NEXT_PUBLIC_SITE_URL=https://www.example.com
PUBLIC_RELEASE=true
# Explicit opt-in for the authenticated custom /admin CMS.
CMS_WORKSPACE_ENABLED=true
# Native Payload routes and local review remain closed.
CMS_ADMIN_ENABLED=false
CMS_LOCAL_REVIEW=false
CMS_INTERFACE_PREVIEW_ENABLED=false
PROJECTS_LOCAL_REVIEW=false
SITE_CONTENT_DATABASE_ENABLED=true
# Enable indexing only after final content/release approval.
SITE_INDEXING_ENABLED=false
SEARCH_WORKER_DISABLED=false
# Persistent external storage: provision and populate before startup.
CMS_UPLOAD_DIRECTORY=/app/uploads
PROJECTS_ASSET_DIRECTORY=/app/project-assets
# Supplied by the repository Docker runtime; adapt for direct Node hosting.
PLAYWRIGHT_EXECUTABLE_PATH=/usr/bin/chromium
