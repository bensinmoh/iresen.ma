# Development only. Run pnpm setup:local to generate private local values.
DATABASE_URL=postgresql://iresen:replace-with-local-password@127.0.0.1:5432/iresen
POSTGRES_USER=iresen
POSTGRES_DB=iresen
POSTGRES_PASSWORD=replace-with-local-password
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep false for development and unpublished environments.
SITE_INDEXING_ENABLED=false
