# Development only. Run pnpm setup:local to generate private local values.
# Local database host port; must match the port in DATABASE_URL.
# Use pnpm setup:local --db-port 5433 when another service already uses 5432.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://iresen:replace-with-local-password@127.0.0.1:5432/iresen
POSTGRES_USER=iresen
POSTGRES_DB=iresen
POSTGRES_PASSWORD=replace-with-local-password
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep false for development and unpublished environments.
SITE_INDEXING_ENABLED=false
# Keep the bounded in-process search index worker enabled unless a separate worker owns it.
SEARCH_WORKER_DISABLED=false
# Optional absolute upload directory shared by the web server and search worker.
# CMS_UPLOAD_DIRECTORY=/absolute/path/to/iresen-uploads
# Supply these temporarily through the environment for pnpm cms:bootstrap.
# CMS_BOOTSTRAP_EMAIL=
# CMS_BOOTSTRAP_PASSWORD=

# Local CMS layout review only; requires CMS_LOCAL_REVIEW too for a local production-build review.
CMS_INTERFACE_PREVIEW_ENABLED=false

# Never enable either administrative surface on the public server.
CMS_ADMIN_ENABLED=false
CMS_LOCAL_REVIEW=false
# Only when the protected reverse proxy STRIPS and OVERWRITES this header.
# Supported: cf-connecting-ip or x-real-ip. Unconfigured clients share a conservative quota.
# TRUSTED_PROXY_CLIENT_IP_HEADER=cf-connecting-ip

# Optional local source-project review (never enabled for PUBLIC_RELEASE=true).
PROJECTS_LOCAL_REVIEW=false
# Standalone deployment: absolute external directory for guarded project images.
# PROJECTS_ASSET_DIRECTORY=/srv/iresen/project-assets

# Optional archival export only; live project PDFs are generated in memory.
# PROJECTS_NOTES_DIRECTORY=/srv/iresen/project-notes
# Runtime Chromium for on-demand PDFs (Docker supplies /usr/bin/chromium).
# PLAYWRIGHT_EXECUTABLE_PATH=/usr/bin/chromium

# Authenticated PostgreSQL-backed CMS (never allowed with PUBLIC_RELEASE=true).
CMS_WORKSPACE_ENABLED=false

# Read the retained public site catalogue from the common authoring database after import.
SITE_CONTENT_DATABASE_ENABLED=false
