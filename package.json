{
  "name": "iresen-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.0 <25",
    "pnpm": "11.28.2"
  },
  "packageManager": "pnpm@11.28.2",
  "scripts": {
    "dev": "node scripts/run.mjs next dev --hostname 0.0.0.0",
    "build": "node scripts/run.mjs next build --webpack",
    "start": "node scripts/run.mjs node scripts/start-production.mjs",
    "lint": "node scripts/run.mjs eslint . --max-warnings=0",
    "typecheck": "node scripts/run.mjs next typegen && node scripts/run.mjs tsc --noEmit",
    "format": "node scripts/run.mjs prettier --write .",
    "format:check": "node scripts/run.mjs prettier --check .",
    "test": "node scripts/run.mjs vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "CMS_INTEGRATION=1 SEARCH_WORKER_DISABLED=true node scripts/run.mjs vitest run src/tests/cms.integration.test.ts src/tests/search.integration.test.ts src/tests/careers.integration.test.ts src/tests/calls.integration.test.ts src/tests/projects.integration.test.ts src/tests/search-limit.integration.test.ts --no-file-parallelism",
    "test:e2e": "node scripts/run.mjs playwright test",
    "setup:local": "node scripts/setup-local.mjs",
    "db:up": "docker compose --env-file .env.local up -d db",
    "db:wait": "node scripts/run.mjs node scripts/wait-for-db.mjs",
    "cms:types": "node scripts/run.mjs payload generate:types",
    "cms:importmap": "node scripts/run.mjs payload generate:importmap",
    "cms:migrate:create": "node scripts/run.mjs payload migrate:create",
    "cms:migrate": "node scripts/run.mjs payload migrate",
    "cms:bootstrap": "node scripts/run.mjs tsx scripts/bootstrap-admin.ts",
    "search:rebuild": "node scripts/run.mjs tsx scripts/search-index.ts rebuild",
    "search:work": "node scripts/run.mjs tsx scripts/search-index.ts work",
    "audit:assets": "node scripts/audit-public-assets.mjs",
    "audit:docs": "node scripts/audit-docs.mjs",
    "audit:performance": "node scripts/performance-audit.mjs"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@phosphor-icons/react": "2.1.10",
    "graphql": "16.14.2",
    "next": "16.4.1",
    "next-intl": "4.14.9",
    "payload": "3.90.2",
    "pg": "8.23.1",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
